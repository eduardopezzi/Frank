# Redis
REDIS_URL=redis://localhost:6379/0

# Blender
BLENDER_PATH=blender
BLENDER_TIMEOUT=600

# Storage
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs

# Render defaults
RENDER_SAMPLES=64
RENDER_RESOLUTION_X=1920
RENDER_RESOLUTION_Y=1080
RENDER_DEVICE=CPU

# API
API_HOST=0.0.0.0
API_PORT=8000
MAX_UPLOAD_SIZE_MB=100
